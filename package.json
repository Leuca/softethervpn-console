{
  "name": "softethervpn-console",
  "version": "0.2.0",
  "description": "A SoftEther VPN Server web management application built with PatternFly 6",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leuca/softethervpn-console.git"
  },
  "homepage": "https://github.com/Leuca/softethervpn-console",
  "license": "MIT",
  "private": true,
  "scripts": {
    "prebuild": "npm run type-check && npm run clean",
    "build": "webpack --config webpack.prod.js",
    "build:integrated": "CONSOLE_MODE=integrated npm run build",
    "build:managed": "CONSOLE_MODE=managed npm run build",
    "build:managed:local": "npm run clean && CONSOLE_MODE=managed webpack --env local --config webpack.prod.js",
    "start": "npm run build:managed:local && npm --prefix gateway run build && npm --prefix gateway run start",
    "start:dev": "webpack serve --color --progress --config webpack.dev.js",
    "test": "vitest run",
    "test:gateway": "npm --prefix gateway test",
    "test:all": "npm test && npm run test:gateway",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eslint": "eslint --ext .tsx,.js ./src/ \"gateway/src/**/*.ts\"",
    "lint:ascii": "node scripts/check-ascii.mjs",
    "lint": "npm run eslint && npm run lint:ascii && npm run format:check",
    "format": "prettier --write \"src/**/*.{tsx,ts}\"",
    "format:check": "prettier --check \"src/**/*.{tsx,ts}\"",
    "type-check": "tsc --noEmit",
    "type-check:gateway": "npm --prefix gateway run type-check",
    "type-check:all": "npm run type-check && npm run type-check:gateway",
    "ci-checks": "npm run type-check:all && npm run lint && npm run test:coverage && npm run test:gateway",
    "build:bundle-profile": "webpack --config webpack.prod.js --profile --json > stats.json",
    "bundle-profile:analyze": "npm run build:bundle-profile && webpack-bundle-analyzer ./stats.json",
    "theme:gen": "node scripts/gen-dark-chrome.mjs",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node-forge": "^1.3.14",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.6",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "dotenv-webpack": "^8.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "html-webpack-plugin": "^5.6.3",
    "jsdom": "^25.0.1",
    "mini-css-extract-plugin": "^2.9.2",
    "postcss": "^8.5.25",
    "prettier": "^3.4.2",
    "raw-loader": "^4.0.2",
    "react-axe": "^3.5.4",
    "rimraf": "^6.0.1",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.5.1",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^4.0.5",
    "webpack": "^5.109.2",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@patternfly/react-core": "6.5.1",
    "@patternfly/react-icons": "6.5.1",
    "@patternfly/react-styles": "6.5.1",
    "@patternfly/react-table": "6.5.1",
    "@peculiar/x509": "^2.0.0",
    "node-forge": "^1.4.0",
    "react": "^18",
    "react-dom": "^18",
    "react-router-dom": "^7.18.2",
    "reflect-metadata": "^0.2.2",
    "vpnrpc": "^1.0.1"
  },
  "author": "Luca Magrone"
}
